{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "concat-synth (prompt for args)",
      "type": "debugpy",
      "request": "launch",
      "module": "concatenative.cli",
      "args": "${command:pickArgs}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "uv sync"
    },
    {
      "name": "concat-synth: youtube download",
      "type": "debugpy",
      "request": "launch",
      "module": "concatenative.cli",
      "args": ["download", "youtube", "--max-snippets", "32", "--out", "youtube_mix.wav"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "uv sync"
    },
    {
      "name": "Current file (scripts)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "uv sync"
    },
    {
      "name": "Debug tests",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
